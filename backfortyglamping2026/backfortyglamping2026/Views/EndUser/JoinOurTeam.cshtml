@{
    ViewBag.Title = "JoinOurTeam";
    Layout = "~/Views/Shared/_LayoutEUMaster.cshtml";
}

@section MetaSection{
<title>Join the Back Forty Glamping Team | Careers </title>
    <meta name="description" content="Join the Back Forty Glamping Team | Careers"/>
}
    <span id="MenuId" style="display: none;">team</span>

<main>

    <section title="Join the Back Forty Team" class="hero-banner" style="background: url('../../assets/images/join-the-back-forty-team.webp');"></section>
    <div class="banner-bottomdesign">
        <img src="../../assets/images/banner-bottomdesign.webp" class="img-fluid w-100 h-100" alt="banner-bottomdesign" loading="lazy">
    </div>

    <section class="policies-sec">
        <div class="container">
            <div class="row mainsec">
                <div class="col-md-12">
                    <div class="main-heading mb-0">
                        <h1>Back Forty Glamping Hospitality Team</h1>
                       
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="policies-box our-teams-box">
                        <div class="policies-text">
                            <h2>ABOUT</h2>
                            <p>
                                Back Forty Glamping is a year round luxury glamping accommodation business located outside of Meaford, ON. There are 7 geodesic domes on site, each sleeping two people. Back Forty gives people an opportunity to encounter nature without having to sacrifice the comforts of home. It is a place people get away to celebrate big life moments with their loved ones!
                            </p>

                        </div>
                        <div class="policies-text">
                            <h2>JOB DESCRIPTION</h2>
                            <p>
                                Being a part of the hospitality team means you play a crucial role in bringing the dome magic to life, ensuring the dome is transformed into a luxurious getaway for every single guest! The hospitality team not only makes things sparkling clean but lays the foundation for an unforgettable getaway guests will talk about for years to come. If you are passionate and dedicated with a sharp eye for detail, <strong>come curate unforgettable experiences with us!</strong>
                            </p>
                        </div>
                        <div class="policies-text">
                            <h2>REQUIREMENTS </h2>

                            <ul>
                                <li>Positive, professional and respectful demeanor and communication skills.</li>
                                <li>Ability to stand, sit, bend, squat or walk for extended periods of time and move and lift up to 30lbs.</li>
                                <li>Willingness and ability to use tech based systems and checklists.</li>
                                <li>Reliable transportation to and from Back Forty.</li>
                                <li>Fluent in English reading and writing.</li>
                                <li>Works well under pressure and in a team environment.</li>
                                <li>Must be available to work Fridays and 3+ Sundays per month.</li>
                            </ul>
                        </div>
                        <div class="policies-text">
                            <h2>DUTIES & RESPONSIBILITIES</h2>
                            <ul>
                                <li>Assist with laundry, washing, drying and folding.</li>
                                <li>Communicate any damages or excessive mess, documented accurately with photos.</li>
                                <li>Consistent and continued communication with the team lead.</li>
                                <li>Basic hot tub maintenance (will train).</li>
                                <li>Light shoveling in the winter.</li>
                                <li>Setting up and staging guest packages and add ons.</li>
                                <li>Performing change over tasks such as cleaning kitchen, bathroom, bedroom and living spaces following a detailed checklist.</li>
                                <li>Communicating inventory needs and keeping inventory closets clean and organized.</li>
                            </ul>
                        </div>
                        <div class="policies-text">
                            <h2>SKILLS & QUALIFICATIONS</h2>
                            <ul>
                                <li>Ability to multitask and work efficiently under pressure</li>
                                <li>Entrepreneurial spirit, excited to learn and willing to bring new ideas to the table.</li>
                                <li>A high degree of attention to detail and professionalism</li>
                                <li>Strong organizational skills and ability to follow systems efficiently</li>
                                <li>Formal training in hospitality is an asset </li>
                                <li>Written and verbal fluency in English</li>
                                <li>Excellent problem-solving and decision-making skills</li>
                            </ul>
                        </div>
                        <div class="policies-text">
                            <h2>DETAILS & COMPENSATION</h2>
                            <ul>
                                <li>Start date: Immediate</li>
                                <li>Part-Time Friday & Sunday</li>
                                <li>Payment: $25 Per Hour</li>
                                <li>Hours: 15-30 hours a month </li>
                                <li>Number of positions: 1</li>
                            </ul>
                        </div>
                        <div class="policies-text mb-lg-5 mb-4">
                            <h2>APPLICATION PROCESS</h2>
                            <p>
                                Candidates are invited to apply with a resume emailed to Info@backfortyglamping.com
                            </p>
                            <p>
                                Only successful candidates will be contacted to discuss the role further.
                            </p>
                            <ul>
                                <li>Start date: Immediate</li>
                                <li>Part-Time Friday & Sunday</li>
                                <li>Payment: $25 Per Hour</li>
                                <li>Hours: 15-30 hours a month </li>
                                <li>Number of positions: 1</li>
                            </ul>

                            
                        </div>
                        <div class="policies-text">
                            <h3>Schedule:</h3>

                            <ul>
                                <li>Must be able to work a minimum three Sundays a month</li>
                                <li>Shift range from 10:00am-4:00pm (4-6 Hours)</li>
                                <li>More hours may be available as we grow and expand</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>